<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="450.0" prefWidth="700.0" styleClass="btn-secondary" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jaqueline.estoque.controller.ProdutoController">
   <top>
      <VBox alignment="CENTER_LEFT" prefHeight="91.0" prefWidth="700.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" contentDisplay="CENTER" styleClass="title-text" text="Dados Produto">
               <VBox.margin>
                  <Insets left="80.0" />
               </VBox.margin>
               <font>
                  <Font name="Arial Black" size="18.0" />
               </font>
            </Label>
         </children>
      </VBox>
   </top>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <VBox prefHeight="65.0" prefWidth="700.0">
               <children>
                  <Label styleClass="text" text="Nome" />
                  <TextField fx:id="campoNome" />
               </children>
            </VBox>
            <VBox layoutX="90.0" layoutY="10.0" prefHeight="65.0" prefWidth="700.0">
               <children>
                  <Label styleClass="text" text="Categoria" />
                  <TextField fx:id="campoCategoria" />
               </children>
            </VBox>
            <VBox layoutX="90.0" layoutY="75.0" prefHeight="65.0" prefWidth="700.0">
               <children>
                  <Label styleClass="text" text="Quantidade" />
                  <TextField fx:id="campoQuantidade" />
               </children>
            </VBox>
            <VBox layoutX="90.0" layoutY="140.0" prefHeight="65.0" prefWidth="700.0">
               <children>
                  <Label text="Preço" />
                  <TextField fx:id="campoPreco" />
               </children>
            </VBox>
            <HBox alignment="CENTER_RIGHT" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button fx:id="botaoCancelar" mnemonicParsing="false" onAction="#cancelar" minHeight="25.0" minWidth="66.0" style="-fx-background-color: #DBCEC3;" text="Cancelar" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin>
                  </Button>
                  <Button fx:id="botaoSalvar" mnemonicParsing="false" onAction="#salvar" minHeight="35.0" minWidth="114.0" style="-fx-background-color: #DBCEC3;" text="Salvar" HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets left="80.0" right="80.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
