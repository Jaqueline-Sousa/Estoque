<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jaqueline.estoque.controller.MenuController">
   <left>
      <VBox prefHeight="600.0" prefWidth="269.0" style="-fx-background-color: #fcd7da;" styleClass="sidebar" stylesheets="@style.css" BorderPane.alignment="CENTER">
         <children>
            <Label prefHeight="28.0" prefWidth="105.0" styleClass="botao-menu" stylesheets="@style.css" text="Estoque">
               <font>
                  <Font name="Californian FB" size="24.0" />
               </font>
               <graphic>
                  <FontIcon iconLiteral="mdi2b-briefcase-variant-outline" iconSize="16" />
               </graphic>
            </Label>
            <Button fx:id="btnVisualizarEstoque" mnemonicParsing="false" onAction="#aoVisualizarEstoque" prefHeight="42.0" prefWidth="188.0" text="Visualizar Estoque">
               <graphic>
                  <FontIcon iconLiteral="mdi2c-clipboard-search-outline" iconSize="16" text="󱘟" />
               </graphic>
               <styleClass>
                  <String fx:value="menu-button" />
                  <String fx:value="menu-button:focused" />
               </styleClass>
            </Button>
            <Button fx:id="btnEntradaProdutos" mnemonicParsing="false" onAction="#aoCadastrarProdutos" prefHeight="42.0" prefWidth="181.0" styleClass="menu-button" text="Entrada de Produtos">
               <graphic>
                  <FontIcon iconLiteral="mdi2c-cellphone-arrow-down" iconSize="16" />
               </graphic>
            </Button>
            <Button fx:id="btnRelatorio" mnemonicParsing="false" onAction="#aoGerarRelatorio" prefHeight="42.0" prefWidth="128.0" style="-fx-background-insets: SINAL_MDI;" styleClass="menu-button" text="Relatório">
               <graphic>
                  <FontIcon iconLiteral="mdi2c-chart-bar" iconSize="16" />
               </graphic>
            </Button>
            <Button fx:id="btnSair" mnemonicParsing="false" onAction="#aoSair" prefHeight="44.0" prefWidth="106.0" styleClass="menu-button" stylesheets="@style.css" text="Sair">
               <graphic>
                  <FontIcon iconLiteral="mdi2e-export" iconSize="22" tabSize="50" text="󰈇" />
               </graphic>
            </Button>
         </children>
      </VBox>
   </left>
   <center>
      <VBox alignment="CENTER" prefHeight="600.0" prefWidth="447.0" style="-fx-background-color: #ffc2ce;" styleClass="main-container" stylesheets="@style.css" BorderPane.alignment="CENTER">
         <children>
            <Label contentDisplay="CENTER" styleClass="title-text" text="Bem-Vindo(a)!" textAlignment="CENTER" textFill="#593630">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <Label styleClass="title-text" text="Selecione uma opcao no menu ao lado." textFill="#6e5551">
               <font>
                  <Font size="14.0" />
               </font></Label>
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
         </children>
      </VBox>
   </center>
</BorderPane>
