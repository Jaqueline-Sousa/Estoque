<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>


<BorderPane prefHeight="450.0" prefWidth="700.0" style="-fx-background-color: #F4EBEA;;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jaqueline.estoque.EstoqueController">
   <top>
      <VBox prefHeight="94.0" prefWidth="700.0" style="-fx-background-color: #F4EBEA;;" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-text-fill: #593630; -fx-font-size: 22px; -fx-font-weight: bold;;" text="Produtos em Estoque">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
               <padding>
                  <Insets left="30.0" top="20.0" />
               </padding>
            </Label>
            <HBox alignment="CENTER" prefHeight="44.0" prefWidth="642.0">
               <children>
                  <TextField prefHeight="25.0" prefWidth="256.0">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </TextField>
                  <Button mnemonicParsing="false" prefHeight="33.0" prefWidth="234.0" styleClass="btn-primary" text="Adicionar">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                     <graphic>
                        <FontIcon iconLiteral="mdi2a-account-plus" />
                     </graphic>
                  </Button>
                  <Button layoutX="159.0" layoutY="10.0" mnemonicParsing="false" prefHeight="33.0" prefWidth="212.0" text="Editar">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                     <graphic>
                        <FontIcon iconLiteral="mdi2b-border-color" iconSize="14" />
                     </graphic>
                     <styleClass>
                        <String fx:value="btn-secondary" />
                        <String fx:value="btn-secondary:hover" />
                     </styleClass>
                  </Button>
                  <Button layoutX="211.0" layoutY="10.0" mnemonicParsing="false" prefHeight="33.0" prefWidth="245.0" styleClass="btn-secondary" text="Remover">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                     <graphic>
                        <FontIcon iconLiteral="mdi2a-account-off-outline" iconSize="14" />
                     </graphic>
                  </Button>
                  <Button layoutX="263.0" layoutY="10.0" mnemonicParsing="false" prefHeight="33.0" prefWidth="248.0" styleClass="btn-secondary" text="Voltar" onAction="#aoVoltarMenu">
                     <graphic>
                        <FontIcon iconLiteral="mdi2a-arrow-u-left-top" iconSize="14" />
                     </graphic>
                  </Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="30.0" right="30.0" top="20.0" />
         </padding>
         <BorderPane.margin>
            <Insets bottom="10.0" left="30.0" right="30.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <TableView prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn prefWidth="86.0" text="ID" />
          <TableColumn prefWidth="150.0" text="Nome" />
            <TableColumn prefWidth="106.0" text="Categoria" />
            <TableColumn prefWidth="162.0" text="Quantidade" />
            <TableColumn prefWidth="134.0" text="Preço (R$)" />
        </columns>
         <BorderPane.margin>
            <Insets left="30.0" right="30.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
